﻿﻿﻿﻿﻿---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 8);
---

<!doctype html>
<html lang="zh-CN">
<head>
	<BaseHead />
</head>
<body>
	<Header />
	<main>
		<section>
			<h1>UST Liuex's Weblog</h1>
			<p style="color: rgb(var(--gray)); margin-bottom: 2em;">学习笔记 · 研究随笔 · 创作记录</p>
		</section>

		<section>
			<h2 style="font-size: 1.5em; margin-bottom: 1em;">最新文章</h2>
			<div class="post-list">
				{posts.map((post) => (
					<article class="post-item">
						<h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
						<div class="post-meta">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.length > 0 && ` · ${post.data.tags.map(t => `#${t}`).join(' ')}`}
						</div>
						<p class="post-excerpt">{post.data.description}</p>
					</article>
				))}
			</div>
			<p style="text-align: center; margin-top: 2em;">
				<a href="/posts/">查看全部文章 →</a>
			</p>
		</section>
	</main>
	<Footer />
</body>
</html>
