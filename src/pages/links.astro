﻿﻿﻿﻿﻿---
import links from '../data/links.json';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<html lang="zh-CN">
<head>
	<BaseHead title={`友链 · ${SITE_TITLE}`} description="友情链接" />
</head>
<body>
	<Header />
	<main>
		<h1>友情链接</h1>
		<p style="color: rgb(var(--gray)); margin-bottom: 0.5em;">欢迎交换友链，请在评论区留言或通过 GitHub 联系我</p>
		<div class="link-grid">
			{links.map((link) => (
				<a class="link-card" href={link.url} target="_blank" rel="noopener">
					<div class="link-avatar" aria-hidden="true"></div>
					<div>
						<h3>{link.name}</h3>
						<p>{link.description}</p>
					</div>
				</a>
			))}
		</div>
	</main>
	<Footer />
</body>
</html>
