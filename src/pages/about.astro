﻿﻿﻿﻿﻿---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_USERNAME, SITE_TITLE } from '../consts';
---

<html lang="zh-CN">
<head>
	<BaseHead title={`关于 · ${SITE_TITLE}`} description="关于博主" />
</head>
<body>
	<Header />
	<main>
		<h1>关于我</h1>
		<p>你好，我是 UST Liuex。这里是我的个人博客，用来记录学习笔记、研究随笔和创作。</p>
		<p>联系方式：<a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank">GitHub</a></p>
	</main>
	<Footer />
</body>
</html>
