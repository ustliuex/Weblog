---
import { SITE_TITLE, GITHUB_USERNAME } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_TITLE}. Built with <a href="https://astro.build" target="_blank">Astro</a>.</p>
	<p><a href="/rss.xml">RSS</a> · <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank">GitHub</a></p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 4em;
	}
	footer a { color: var(--accent); text-decoration: none; }
	footer a:hover { text-decoration: underline; }
	footer p { margin: 0.25em 0; font-size: 0.9em; }
</style>
