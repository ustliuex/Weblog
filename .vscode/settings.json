{
  "markdown-paste-image.savePath": "public/images",
  "markdown-paste-image.pathRel": "",
  "markdown-paste-image.duplicateFileRename": true,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.snippetSuggestions": "top",
    "editor.tabCompletion": "snippet",
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    }
  },
  "markdown.extension.toc.levels": "2..3",
  "markdown.extension.toc.updateOnSave": true,
  "markdown.extension.toc.slugifyMode": "github"
}
